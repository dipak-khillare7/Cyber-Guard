# Application Configuration
APP_NAME="AI Cybersecurity Threat Detection & Response System"
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Configuration (Supports MySQL and SQLite)
DATABASE_URL=sqlite:///./cyber_security.db

# Security & CORS
# In development, an unset key is generated temporarily for this process.
# Production requires a unique value of at least 32 bytes.
SECRET_KEY=
# Set a unique 12-72 byte password to seed the initial administrator.
ADMIN_INITIAL_PASSWORD=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Email OTP verification (configure a real SMTP relay before enabling registration)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Cyber Guard


# ML Configuration
MODEL_DIR=app/ml/models
