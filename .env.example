# Application Configuration
APP_NAME="AI Cybersecurity Threat Detection & Response System"
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000

# Compose Database Configuration
# Set DATABASE_URL to a MySQL URL using host "db" and URL-encoded credentials
# matching MYSQL_USER, MYSQL_PASSWORD, and MYSQL_DATABASE below.
DATABASE_URL=
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Security & CORS
# Generate a unique value of at least 32 bytes for production.
SECRET_KEY=
# Set a unique 12-72 byte password to seed the initial administrator.
ADMIN_INITIAL_PASSWORD=
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Optional VirusTotal v3 URL reputation lookups. Keep the key server-side.
VIRUSTOTAL_API_KEY=925f6dcb39466cb0cfa462c7b01444464d286b82395838d9fa3f975c692efb87
VIRUSTOTAL_LOOKUP_LIMIT_PER_MINUTE=4

# Email OTP verification (configure a real SMTP relay before enabling registration)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Cyber Guard

# ML Configuration
MODEL_DIR=app/ml/models
